# A integração é opcional. Sem chave, o sistema usa análise local demonstrativa.
AISA_API_KEY=
AISA_MODEL=gpt-4.1
PORT=3333
DATABASE_URL=

# Chave obrigatória para POST /api/integrations/leads e /api/mcp.
# Gere um valor aleatório longo e salve somente nas variáveis protegidas da Vercel.
INTEGRATION_API_KEY=

# Protege o webhook genérico legado quando ele precisar permanecer habilitado.
WEBHOOK_TOKEN=

# Opcional: Chave oficial da Google Places API (New) para enriquecimento avançado
GOOGLE_MAPS_API_KEY=

# Opcional: Integração oficial com o Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# URL pública da API usada pelo frontend em produção (sem barra no final).
VITE_API_URL=https://api-prospector-delta.vercel.app
